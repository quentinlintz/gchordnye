---
import "@picocss/pico/css/pico.classless.blue.min.css";
import "../styles/site.css";
import InstrumentGuide from "../components/InstrumentGuide.astro";
import Countdown from "../components/Countdown.astro";
import PerformanceGallery from "../components/PerformanceGallery.astro";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href={import.meta.env.BASE_URL + "favicon.ico"} />
    <link rel="canonical" href="https://gchordnye.com/" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>G Chord NYE 2026</title>
    <meta property="og:title" content="G Chord NYE 2026" />
    <meta
      name="description"
      content="At your local midnight on December 31, face west and play a G chord or note in support of human-made music."
    />
    <meta
      property="og:description"
      content="At your local midnight on December 31, face west and play a G chord or note in support of human-made music."
    />
    <meta property="og:url" content="https://gchordnye.com/" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="G Chord NYE" />
    <meta property="og:image" content="https://gchordnye.com/gchordnye.png" />
    <meta property="og:image:alt" content="Midnight Chord Club logo" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <header>
      <h1>G Chord NYE</h1>
      <p>Supporting human musicianship in response to AI-generated music</p>
      <time datetime="2026-12-31">December 31, 2026</time>
      <p>Midnight in your local time zone: when 2026 becomes 2027</p>
    </header>
    <main>
      <section>
        <Countdown />
      </section>
      <section>
        <h2>How to join</h2>
        <ol>
          <li>Prepare your instrument</li>
          <li>Face west</li>
          <li>Play a G chord or G note</li>
        </ol>
        <p>
          If you sing, play percussion, or cannot face west, you are still
          welcome to participate!
        </p>
      </section>
      <InstrumentGuide />
      <section>
        <h2>Record and share</h2>
        <p>
          Recording is optional. The important part is playing. If you want to
          share your performance, record it at your local midnight and post it
          on Instagram when you're ready.
        </p>
        <p>
          Tag <a href="https://instagram.com/quentinlintz">@quentinlintz</a> and add
          {" "}<strong>#gchordnye</strong> so the community can find it!
        </p>
      </section>
      <section>
        <h2>Join the Midnight Chord Club</h2>
        <p>
          Join more than 800 people in the Midnight Chord Club, a Discord
          community dedicated to G Chord NYE, created by <a
            href="https://instagram.com/quentinlintz">Quentin Lintz</a
          > and Magzie Ahlström.
        </p>
        <p>
          <a href="https://discord.gg/KN6VYYny6s"
            >Join the Midnight Chord Club on Discord</a
          >
        </p>
      </section>
      <PerformanceGallery />
    </main>
    <footer>
      This site was <a href="https://github.com/quentinlintz/gchordnye"
        >coded by hand</a
      >, by humans
    </footer>
  </body>
</html>
